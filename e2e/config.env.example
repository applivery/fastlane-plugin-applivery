# Copy this file to e2e/config.env (git-ignored) and fill in real values.
#
#   cp e2e/config.env.example e2e/config.env
#
# The end-to-end tests upload real builds to a real Applivery app, so the token
# below must be an integration token of an app that accepts the build file.

# Integration token: App Settings -> Integrations
E2E_APP_TOKEN=your-applivery-integration-token

# Tenant name or base domain. Leave empty to use the public applivery.io
E2E_TENANT=your-tenant.applivery.dev

# Absolute path to the IPA/APK/AAB to upload. It is mounted read-only into the
# containers, so it can live anywhere Docker is allowed to share.
E2E_BUILD_PATH=/absolute/path/to/build.apk

# Token used by the scenarios that must fail with "app_token is not valid"
E2E_BAD_TOKEN=e2e-invalid-token

# Optional: groups of your tenant for the `filter` scenario, e.g. "qa,beta|devs".
# When empty an invented value is used and the scenario only warns if the API
# rejects it.
E2E_FILTER_GROUPS=

# Optional: seconds allowed for a single scenario before it is killed (600)
E2E_SCENARIO_TIMEOUT=
